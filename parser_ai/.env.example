# Copy to .env locally. Never put real keys in .env.example or Git.
OPENAI_API_KEY=

PARSER_AI_MODEL=gpt-6-astra
PARSER_AI_REASONING_EFFORT=high
PARSER_AI_MAX_OUTPUT_TOKENS=32768
PARSER_AI_TIMEOUT_SECONDS=240
PARSER_AI_CONCURRENCY=2
# Optional independent semantic review: off or on. Adds API calls.
PARSER_AI_REVIEW=on
